# Copy to test/capture/secrets.env (gitignored). Sourced by capture.py before the app starts.
#
# OAuth app credentials for the "Link via OAuth" flow on the profile page. Each app must have its callback URL set to
#   http://localhost:8080/api/scm-oauth/<provider>/callback
# They are applied as env-var overrides of providers.<name>.oauth.* — the double-underscore form is needed because
# the keys are hyphenated. fogwall reads the secret from a FILE, never from an env var, so point CLIENT_SECRET_PATH
# at a file you keep outside this repository. Set only the providers you want linked; the rest are skipped, and their
# identity rows are then simply not OAuth-verified.

# export FOGWALL_PROVIDERS__GITHUB__OAUTH__CLIENT_ID=""
# export FOGWALL_PROVIDERS__GITHUB__OAUTH__CLIENT_SECRET_PATH=""

# export FOGWALL_PROVIDERS__GITLAB__OAUTH__CLIENT_ID=""
# export FOGWALL_PROVIDERS__GITLAB__OAUTH__CLIENT_SECRET_PATH=""

# export FOGWALL_PROVIDERS__CODEBERG__OAUTH__CLIENT_ID=""
# export FOGWALL_PROVIDERS__CODEBERG__OAUTH__CLIENT_SECRET_PATH=""

# export FOGWALL_PROVIDERS__GITEA__OAUTH__CLIENT_ID=""
# export FOGWALL_PROVIDERS__GITEA__OAUTH__CLIENT_SECRET_PATH=""
