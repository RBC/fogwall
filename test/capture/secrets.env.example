# Copy to test/capture/secrets.env (gitignored). Sourced by capture.py before the app starts.
#
# OAuth app credentials for the "Link via OAuth" flow on the profile page. Each app must have its callback URL set to
#   http://localhost:8080/api/scm-oauth/<provider>/callback      (see docs/CONFIGURATION.md#scm-oauth)
# They are applied as env-var overrides of providers.<name>.oauth.* — the double-underscore form is needed because
# the keys are hyphenated. fogwall reads the secret from a FILE (client-secret-path), never from an env var.
#
# This template expects one JSON file per provider at $HOME/repos/fogwall-<provider>-oauth.json holding
#   { "client_id": "...", "client_secret": "..." }     (GitLab exports "application_id" instead of "client_id")
# and extracts the secret into a 0600 file under $HOME on first use. Delete a provider from the list to skip
# linking it; its identity rows will then just not be OAuth-verified.

for provider in github gitlab codeberg gitea; do
    json="$HOME/repos/fogwall-${provider}-oauth.json"
    [ -f "$json" ] || { echo "secrets.env: no $json — skipping $provider OAuth" >&2; continue; }

    secret_file="$HOME/.fogwall-oauth-${provider}-secret"
    [ -f "$secret_file" ] || { umask 077; jq -r '.client_secret' "$json" > "$secret_file"; }

    client_id="$(jq -r '.client_id // .application_id' "$json")"
    var="FOGWALL_PROVIDERS__$(echo "$provider" | tr '[:lower:]' '[:upper:]')__OAUTH__"
    export "${var}CLIENT_ID=${client_id}"
    export "${var}CLIENT_SECRET_PATH=${secret_file}"
done
unset provider json secret_file client_id var
