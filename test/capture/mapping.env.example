# Copy to test/capture/mapping.env (gitignored) and fill in YOUR real values.
#
# capture.py uses these two ways:
#   * reverse — placeholder → real, to turn fogwall-playwright.yml into a profile that actually resolves your identity
#   * forward — real → placeholder, to scrub the captured database before it is committed as fogwall.sql
#
# The placeholders themselves are fixed in fogwall-playwright.yml and asserted on by the Playwright specs; only the
# right-hand sides here change per person.

# Your SCM handle. Must be the SAME login on github.com, gitlab.com and gitea.com, and the owner of the test repos.
REAL_HANDLE="coopernetes"

# Display name used as git author/committer name.
REAL_NAME="Thomas Cooper"

# Primary email registered on your provider accounts — commit author email for the "fully verified" pushes.
# Its domain is also swapped into the commit.author.email.domain.allow regex (placeholder: example.org).
REAL_EMAIL="you@your-domain.example"

# A second email registered on at least one provider account (shows up as an OAuth-verified email after linking).
# Leave empty if you have none.
REAL_ALT_EMAIL=""

# Public key file of the SSH key loaded in your ssh-agent AND registered on github.com.
REAL_SSH_PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"

# Test repositories are NOT configured here: capture.py creates a private, randomly-suffixed repo on each provider
# under REAL_HANDLE and deletes it on exit. The suffix is scrubbed away in the dump (repo name: fogwall-fixture).

# PAT files (one token per file). Env vars GITHUB_PAT etc. take precedence. Each token must be able to create and
# delete repositories on its provider:
#   GitHub          repo + delete_repo
#   GitLab          api
#   Codeberg/Gitea  write:user (create under your account) + write:repository + read:user
GITHUB_PAT_FILE="$HOME/.github-pat"
GITLAB_PAT_FILE="$HOME/.gitlab-pat"
CODEBERG_PAT_FILE="$HOME/.codeberg-pat"
GITEA_PAT_FILE="$HOME/.gitea-pat"
